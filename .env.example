# The URL where this application is running. It must exactly match a redirect URI
# configured on the Google OAuth client.
APP_BASE_URL=http://127.0.0.1:8000

# Generate a long random value before exposing this app beyond your own computer.
SESSION_SECRET=replace-this-with-a-long-random-secret

# Download this OAuth client JSON from Google Cloud Console. Do not commit it.
GOOGLE_CLIENT_SECRETS=client_secret.json
GOOGLE_TOKEN_FILE=data/google_token.json

# For Render or another host, do not commit client_secret.json. Instead set this
# secret to a base64-encoded copy of the client JSON in the host's secret manager.
GOOGLE_CLIENT_SECRETS_B64=

# Set to /var/data when a production host attaches a persistent disk.
APP_DATA_DIR=data

# Keep the web app local by default. Set a password if you bind it to a network.
APP_PASSWORD=
MAX_CONCURRENT_JOBS=1
DELETE_LOCAL_AFTER_SUCCESS=true
